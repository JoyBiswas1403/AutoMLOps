MLFLOW_PORT=5000
API_PORT=8000
TF_SERVING_PORT=8501
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
AIRFLOW_WEB_PORT=8080

# MLflow backend (Postgres) and artifacts (MinIO)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
POSTGRES_PORT=5432

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=mlflow
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123

# API canary routing
CANARY_ENABLED=true
CANARY_PERCENT=10

# MODEL NAME
MODEL_NAME=model

# =============================================================================
# Notifications (configure ONE of these)
# =============================================================================
# Discord webhook URL (free - recommended)
# Get one at: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Slack webhook URL (optional)
# Get one at: api.slack.com/apps > Create App > Incoming Webhooks
SLACK_WEBHOOK_URL=

# Generic webhook (fallback)
WEBHOOK_URL=
